class Solution(object):
    def threeSum(self, nums):
        list=[]
        for i in range(len(nums)):
            for j in range(len(nums)):
                for k in range(len(nums)):
                    if i!=j and i!=k and j!=k and nums[i] + nums[j] + nums[k] == 0:
                        s=sorted([nums[i],nums[j],nums[k]])
                        if s not in list: 
                           list.append(s)
        
        return list
