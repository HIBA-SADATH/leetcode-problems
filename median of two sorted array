class Solution(object):
    def findMedianSortedArrays(self, nums1, nums2):
        """
        :type nums1: List[int]
        :type nums2: List[int]
        :rtype: float
        """
        num=nums1+nums2
        num.sort()
        l=len(num)
        n=l//2
        if l%2==0:
        
            a=(num[n-1]+num[n])/2.0
            return a
            
        else:
            b=num[n]
            return b
